# ─────────────────────────────────────────────────────────────
#  Avish Boricha — Portfolio environment variables
#  Copy this file to ".env" locally, or add them in
#  Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (contact form archive).
# Local dev: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Vercel:    use Neon / Vercel Postgres and paste the pooled URL here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Resend (https://resend.com — free tier: 100 emails/day).
# Create an account, generate an API key, paste it here.
# Without it the site still works; messages are stored in the DB only.
RESEND_API_KEY=

# Where contact-form inquiries are delivered (defaults to Avish's email).
CONTACT_TO_EMAIL=avishahir4812@gmail.com

# Sender identity. resend.dev works out of the box; swap for your
# verified domain later, e.g. "Portfolio <hello@avishboricha.dev>"
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

node_modules/
.env
.env.local
dist/
